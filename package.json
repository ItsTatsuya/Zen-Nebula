{
  "name": "nebula-nova",
  "version": "3.5.0",
  "author": "ItsTatsuya",
  "description": "A glass-inspired theme for Zen Browser with customizable blur, animation, and media artwork.",
  "homepage": "https://github.com/ItsTatsuya/Zen-Nebula",
  "repository": {
    "type": "git",
    "url": "https://github.com/ItsTatsuya/Zen-Nebula.git"
  },
  "private": true,
  "scripts": {
    "check:config": "node scripts/check-config.mjs",
    "lint": "bun lint:pretty && stylelint '**/*.css'",
    "lint:fix": "bun pretty && stylelint '**/*.css' --fix",
    "lint:pretty": "prettier . --check",
    "pretty": "prettier . --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
